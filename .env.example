UNIFI_URL=https://console.example.com
UNIFI_USERNAME_FILE=/run/secrets/unifi_username
UNIFI_PASSWORD_FILE=/run/secrets/unifi_password

LEGO_DOMAINS=console.example.com
LEGO_CERT_NAME=unifi
LEGO_EMAIL=ops@example.com
LEGO_ACCEPT_TOS=true
LEGO_FORCE_CERT_DOMAINS=true
LEGO_LOG_LEVEL=INFO
LEGO_DNS=hurricane
HURRICANE_TOKENS_FILE=/run/secrets/hurricane_tokens

# For separate certificates, replace LEGO_DOMAINS and LEGO_CERT_NAME with:
# LEGO_CERTIFICATES=home,protect
# LEGO_HOME_DOMAINS=unifi.home.example.com
# LEGO_PROTECT_DOMAINS=protect.home.example.com
# Configure matching UNIFI_TARGETS as shown in docs/configuration.md.

# Optional certificate name, cleanup, schedule, and TLS settings:
# UNIFI_CERT_NAME=unifi-os-le-cert-deployer
# UNIFI_CLEANUP=false
# CRON_SCHEDULE=0 0 * * *
# LEGO_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# UNIFI_HTTP_TIMEOUT=30s
# UNIFI_SKIP_TLS_VERIFY=true
